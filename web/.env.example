# ==============================================================================
# VIVIPRESSONFIT — Frontend Environment Variables Template
# ==============================================================================
# Copie este archivo a '.env' para desarrollo local o configure estas variables
# en la sección de Environment Variables de Vercel (Production / Preview).
#
# IMPORTANTE:
# - Ninguna variable con prefijo 'VITE_' es secreta: todas se empaquetan en el
#   código JavaScript del cliente en tiempo de compilación.
# - NUNCA agregue 'SUPABASE_SERVICE_ROLE_KEY' ni 'STRIPE_SECRET_KEY' en este archivo.
# ==============================================================================

# Supabase — URL del proyecto (Settings → API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase — Clave pública anónima (Settings → API → anon/public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ejemplo_anon_key

# Stripe — Clave pública publicable (Dashboard Stripe → API keys → Publishable key)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Canal oficial de soporte en WhatsApp (código de país sin signos, ej: Argentina 5493415888117)
VITE_WHATSAPP_NUMBER=5493415888117

