# ==============================================================================
# VIVIPRESSONFIT — Supabase Edge Functions Environment Secrets Template
# ==============================================================================
# Configure estos secretos usando Supabase CLI o en el panel de Supabase:
#   Project Settings → Edge Functions → Secrets
#
# Comando CLI:
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_... STRIPE_PRICE_ID=price_...
# ==============================================================================

# Supabase (Inyectados automáticamente por el runtime de Supabase en producción)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe — Credenciales de integración y webhooks
STRIPE_SECRET_KEY=sk_live_tu_clave_secreta_de_stripe
STRIPE_PRICE_ID=price_tu_price_id_recurrente_mensual
STRIPE_WEBHOOK_SECRET=whsec_tu_firma_secreta_de_webhook

# Dominios permitidos para redirección tras checkout y portal (separados por coma)
APP_ORIGIN=https://vivipressonfit.com,https://vivi-pressonfit.vercel.app

# Bunny Stream — Transmisión de video HLS y generación de tokens de seguridad
BUNNY_STREAM_LIBRARY_ID=123456
BUNNY_STREAM_API_KEY=tu-api-key-de-bunny-stream
BUNNY_STREAM_TOKEN_KEY=tu-token-security-key-para-firmado-sha256
BUNNY_STREAM_HOSTNAME=video.vivipressonfit.com

